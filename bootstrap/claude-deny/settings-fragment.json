{
  "permissions": {
    "deny": [
      "Skill(skill:pstack:poteto-mode)",
      "Skill(skill:pstack:tdd)",
      "Skill(skill:pstack:reflect)",
      "Skill(skill:pstack:setup-pstack)",
      "Skill(skill:compound-engineering:lfg)",
      "Skill(skill:compound-engineering:ce-babysit-pr)",
      "Skill(skill:compound-engineering:ce-bakeoff)",
      "Skill(skill:compound-engineering:ce-brainstorm)",
      "Skill(skill:compound-engineering:ce-commit)",
      "Skill(skill:compound-engineering:ce-commit-push-pr)",
      "Skill(skill:compound-engineering:ce-compound)",
      "Skill(skill:compound-engineering:ce-compound-refresh)",
      "Skill(skill:compound-engineering:ce-debug)",
      "Skill(skill:compound-engineering:ce-doc-review)",
      "Skill(skill:compound-engineering:ce-explain)",
      "Skill(skill:compound-engineering:ce-handoff)",
      "Skill(skill:compound-engineering:ce-ideate)",
      "Skill(skill:compound-engineering:ce-optimize)",
      "Skill(skill:compound-engineering:ce-plan)",
      "Skill(skill:compound-engineering:ce-pov)",
      "Skill(skill:compound-engineering:ce-proof)",
      "Skill(skill:compound-engineering:ce-prototype)",
      "Skill(skill:compound-engineering:ce-resolve-pr-feedback)",
      "Skill(skill:compound-engineering:ce-riffrec-feedback-analysis)",
      "Skill(skill:compound-engineering:ce-simplify-code)",
      "Skill(skill:compound-engineering:ce-strategy)",
      "Skill(skill:compound-engineering:ce-test-browser)",
      "Skill(skill:compound-engineering:ce-work)",
      "Skill(skill:compound-engineering:ce-worktree)"
    ]
  },
  "hooks": {
    "UserPromptExpansion": [
      {
        "matcher": "^((pstack:)?(poteto-mode|tdd|reflect|setup-pstack)|(compound-engineering:)?lfg)$",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Blocked (PER-89): this command is disabled on this machine (pstack poteto-mode/tdd/reflect/setup-pstack, compound-engineering lfg). See ops bootstrap/claude-deny/README.md.' >&2; exit 2",
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/disabled-cmd-prompt-guard.sh\""
          }
        ]
      }
    ]
  }
}
