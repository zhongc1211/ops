-# Run from the repo root after `npm run build:worker` for the same mode.
-# Needs `cf` on PATH and CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID set.
+# Run from the repo root after the build for the same mode (scripts/ci/cf-build.sh).
+# Needs CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID; Workers Builds sets both.
 #
 # cf 1.0.0-beta.14 detects the repo as plain Next.js and refuses `--mode`, so
 # the deploy runs from a staging folder that holds only worker.js, .open-next/,
@@ -14,6 +15,9 @@
 # account and mode are the expected ones.
 set -euo pipefail
 
+CF_CLI_VERSION=1.0.0-beta.14
+EXPECTED_ACCOUNT=7549b9c77aa27ea8c1a8b394d9b71490
+
 mode=${1:?usage: cf-deploy.sh <testing|production>}
 case "$mode" in
 	testing) expected=deepvision-site-testing ;;
@@ -22,7 +26,18 @@ case "$mode" in
 esac
 : "${CLOUDFLARE_API_TOKEN:?CLOUDFLARE_API_TOKEN is not set}"
 : "${CLOUDFLARE_ACCOUNT_ID:?CLOUDFLARE_ACCOUNT_ID is not set}"
-[ -f .open-next/worker.js ] || { echo "No .open-next build. Run npm run build:worker first." >&2; exit 1; }
+if [ "$CLOUDFLARE_ACCOUNT_ID" != "$EXPECTED_ACCOUNT" ]; then
+	echo "CLOUDFLARE_ACCOUNT_ID is not the deepvision-site account. Stopping." >&2
+	exit 1
+fi
+[ -f .open-next/worker.js ] || { echo "No .open-next build. Run scripts/ci/cf-build.sh first." >&2; exit 1; }
+
+# Use the pinned cf; install it next to the build if PATH has another version.
+if command -v cf >/dev/null && [ "$(cf --version 2>/dev/null)" = "$CF_CLI_VERSION" ]; then
+	cf=(cf)
+else
+	cf=(npx --yes "cf@$CF_CLI_VERSION")
+fi
 
