@@ -35,8 +50,8 @@ wrangler_version=$(node -p 'require("./node_modules/wrangler/package.json").vers
 printf '{"name":"deepvision-site-cf-stage","private":true,"type":"module","devDependencies":{"wrangler":"%s"}}\n' \
 	"$wrangler_version" > "$stage/package.json"
 
-sha=$(git rev-parse --short HEAD)
-message="${GITHUB_REF_NAME:-local} $sha${GITHUB_RUN_ID:+ run $GITHUB_RUN_ID}"
+sha=${WORKERS_CI_COMMIT_SHA:-$(git rev-parse HEAD 2>/dev/null || echo unknown)}
+message="${WORKERS_CI_BRANCH:-local} ${sha:0:7}${WORKERS_CI_BUILD_UUID:+ build $WORKERS_CI_BUILD_UUID}"
 cd "$stage"
 
 # Reads the Worker name, account and mode that cf wrote for the last build.
@@ -50,25 +65,26 @@ check_target() {
 		echo "Target Worker does not match. Stopping." >&2
 		exit 1
 	fi
-	if [ "$account" != "$CLOUDFLARE_ACCOUNT_ID" ]; then
-		echo "Target account does not match CLOUDFLARE_ACCOUNT_ID. Stopping." >&2
+	if [ "$account" != "$EXPECTED_ACCOUNT" ]; then
+		echo "Target account does not match. Stopping." >&2
 		exit 1
 	fi
 }
 
 echo "== Dry run ($mode)"
-cf deploy --dry-run --mode "$mode" --message "$message"
+"${cf[@]}" deploy --dry-run --mode "$mode" --message "$message"
 check_target "Dry run"
+if [ -n "${CF_DRY_RUN_ONLY:-}" ]; then exit 0; fi
 
 echo "== Deploy ($mode)"
-cf deploy --mode "$mode" --message "$message" 2>&1 | tee deploy.log
+"${cf[@]}" deploy --mode "$mode" --message "$message" 2>&1 | tee deploy.log
 check_target "Deploy"
 grep -q "Uploaded $expected " deploy.log || { echo "Deploy log does not name $expected." >&2; exit 1; }
 version=$(grep -oE 'Current Version ID: [0-9a-f-]{36}' deploy.log | awk '{print $4}' | tail -1)
 [ -n "$version" ] || { echo "No version id in the deploy log." >&2; exit 1; }
 
 # The newest deployment must serve the new version to all traffic.
-active=$(cf workers deployments list --worker "$expected" |
+active=$("${cf[@]}" workers deployments list --worker "$expected" |
 	node -e 'const d=JSON.parse(require("fs").readFileSync(0,"utf8")).deployments[0];
 		const v=d.versions.find(v=>v.percentage===100); process.stdout.write(v ? v.version_id : "")')
 if [ "$active" != "$version" ]; then
@@ -76,7 +92,3 @@ if [ "$active" != "$version" ]; then
 	exit 1
 fi
 echo "Deployed $expected version $version"
-if [ -n "${GITHUB_OUTPUT:-}" ]; then echo "version_id=$version" >> "$GITHUB_OUTPUT"; fi
-if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
-	printf '### %s\n\n- Worker: `%s`\n- Version: `%s`\n- Commit: `%s`\n' "$mode" "$expected" "$version" "$sha" >> "$GITHUB_STEP_SUMMARY"
-fi
