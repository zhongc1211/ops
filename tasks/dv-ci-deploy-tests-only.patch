diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
new file mode 100644
index 0000000..060a3e2
--- /dev/null
+++ b/.github/workflows/test.yml
@@ -0,0 +1,31 @@
+# Lint and unit tests for pull requests and for pushes to staging and main.
+# Deploys are not done here: Cloudflare Workers Builds deploys the testing
+# Worker from staging (see scripts/ci/cf-build.sh and scripts/ci/cf-deploy.sh).
+
+name: Test
+
+on:
+  pull_request:
+  push:
+    branches: [staging, main]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: test-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22.23.2
+          cache: npm
+      - run: npm ci
+      - run: npm run lint
+      - run: npm test
diff --git a/scripts/ci/cf-build.sh b/scripts/ci/cf-build.sh
new file mode 100755
index 0000000..43e783c
--- /dev/null
+++ b/scripts/ci/cf-build.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+# Builds the Worker for one mode, then runs the cf dry run and checks the target
+# Worker name and account. Workers Builds runs it as the build command.
+#
+# Usage: scripts/ci/cf-build.sh <testing|production>
+#
+# testing: NEXT_PUBLIC_SAMPLE_MEDIA=on, NEXT_PUBLIC_DASHBOARD_COPY=on
+# production: NEXT_PUBLIC_SAMPLE_MEDIA=on, dashboard copy off
+set -euo pipefail
+
+mode=${1:?usage: cf-build.sh <testing|production>}
+case "$mode" in
+	testing)
+		export NEXT_PUBLIC_SAMPLE_MEDIA=on NEXT_PUBLIC_DASHBOARD_COPY=on
+		npm run build:worker:testing
+		;;
+	production)
+		export NEXT_PUBLIC_SAMPLE_MEDIA=on
+		unset NEXT_PUBLIC_DASHBOARD_COPY
+		npm run build:worker -- --env production
+		;;
+	*) echo "Unknown mode: $mode" >&2; exit 2 ;;
+esac
+
+CF_DRY_RUN_ONLY=1 "$(dirname "$0")/cf-deploy.sh" "$mode"
