#!/bin/bash
# E2E fault shim (F10/F11): put this dir first in PATH for the script under test only.
# A call whose command line matches the regex in E2E_FAIL_SCP fails with 255 and is logged to
# E2E_SHIM_LOG; every other call is the real /usr/bin/scp, unchanged.
if [ -n "${E2E_FAIL_SCP:-}" ] && [[ "$*" =~ $E2E_FAIL_SCP ]]; then
  echo "$(date '+%F %T') scp failed on purpose: $*" >> "${E2E_SHIM_LOG:-/dev/null}"
  echo "scp (E2E shim): failed on purpose" >&2
  exit 255
fi
exec /usr/bin/scp "$@"
