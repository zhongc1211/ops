#!/usr/bin/env python3
# agent-probe [--plain]: 列出本机正在跑的 coding agent 进程和 notify-run 进程，给 stuck-check.sh 用。
# iMac 和 box 都装在 ~/.local/bin/。stuck-check.sh 在 iMac 上直接调用，在 box 上通过一个临时 Orca 终端调用。
# 输出：@@PROBE-BEGIN / @@PROBE-END 之间是 base64(gzip(JSON))，分行不影响解析（终端折行也没关系）；
#   --plain 直接打印 JSON，给人看。
# JSON：{"host", "ts", "procs": [{"pid", "ppid", "kind": "agent"|"notify-run", "name", "stat", "etime_s",
#        "cwd", "agent_anc_cwds": [祖先 agent 进程的 cwd], "wraps_agent": notify-run 的子孙里有没有 agent}]}
#   wraps_agent 为真的 notify-run 是包住整个 agent 的那一层，不算「有长命令在跑」。
#   notify-run 进程多一个 "bot"（它的 --bot 参数）；agent 进程多一个 "dispatch_bot"（最近一层祖先 notify-run 的 --bot），
#   stuck-check 用它认派活的 bot（营销这类没有自己仓库的 bot 只能这样认）。没有时为 null。
#   每个进程还有 "notify_anc"（祖先里有没有 notify-run）、"pane"（环境变量 ORCA_PANE_KEY，即 Orca 的 tabId:leafId，
#   读不到为 null）、"in_orca"（在 Orca 终端里：有 pane 或祖先是 Orca）。顶层 agent（祖先里没有 agent）且没有 notify-run
#   包着时多一个 "args_head"：命令行压成一行的前 400 个字符，给 stuck-check 比对是不是 Orca 自动任务起的（不写日志）。
# "stops"：agent-stop 写的「主动停止」标记（~/.orca-state/agent-stops/，48 小时内），stuck-check 用来不报主动停掉的 agent。
# "wake"：这台机器上叫醒有没有送达（PER-67 F2、F6）：{"sessions": orca-wake 会话（48 小时内动过的）的 agent、cwd、turn、
#   当前回合有没有 woken、last_event、last_event_ts、agent_pid、orca_terminal、bot；"nr": notify-run.log 最后 400 行（ts、bot、status、
#   http、try、ws、pane、agent）}。读 ORCA_WAKE_STATE_DIR / NOTIFY_RUN_LOG（默认路径同 orca-wake、notify-run）。
# 只读，不改任何东西。
import base64, datetime, gzip, json, os, re, socket, subprocess, sys, time

AGENTS = {"claude", "codex", "pi", "gemini", "opencode", "grok", "cursor-agent", "omp", "codebuddy"}
RUNTIMES = {"node", "bun", "deno", "python", "python3"}
SHELLS = {"bash", "sh", "zsh", "dash"}


def etime_s(s):
    days, _, rest = s.partition("-") if "-" in s else ("0", "", s)
    parts = [int(x) for x in rest.split(":")]
    while len(parts) < 3:
        parts.insert(0, 0)
    return int(days) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


def classify(args):
    tok = args.split()
    if not tok:
        return None, None
    strip = lambda t: re.sub(r"\.(?:js|mjs|cjs|py)$", "", os.path.basename(t))
    b0 = strip(tok[0])
    b1 = strip(tok[1]) if len(tok) > 1 else ""
    if b0 == "notify-run" or (b0 in SHELLS and b1 == "notify-run"):
        return "notify-run", "notify-run"
    if b0 in AGENTS:
        return "agent", b0
    if b0 in RUNTIMES and b1 in AGENTS:
        return "agent", b1
    return None, None


def cwds_of(pids):
    out = {}
    if not pids:
        return out
    if os.path.isdir("/proc/self"):
        for p in pids:
            try:
                out[p] = os.readlink("/proc/%d/cwd" % p)
            except OSError:
                pass
        return out
    try:
        r = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fpn", "-p", ",".join(str(p) for p in pids)],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return out
    cur = None
    for ln in r.stdout.splitlines():
        if ln.startswith("p"):
            cur = int(ln[1:])
        elif ln.startswith("n") and cur is not None:
            out[cur] = ln[1:]
    return out


def panes_of(pids):
    """pid → ORCA_PANE_KEY。Linux 读 /proc/<pid>/environ；macOS 用 ps -E（只看得到自己用户的进程）。"""
    out = {}
    for p in pids:
        env = ""
        if os.path.isdir("/proc/self"):
            try:
                env = open("/proc/%d/environ" % p, "rb").read().decode("utf-8", "replace").replace("\0", " ")
            except OSError:
                continue
        else:
            try:
                env = subprocess.run(["ps", "-E", "-o", "command=", "-p", str(p)], capture_output=True, text=True,
                                     timeout=10).stdout
            except (OSError, subprocess.TimeoutExpired):
                continue
        m = re.search(r"(?:^|\s)ORCA_PANE_KEY=([\w:.-]+)", env)
        if m:
            out[p] = m.group(1)
    return out


def stop_marks():
    """agent-stop 写的「主动停止」标记（STOP_KEEP_H 小时内的）：stuck-check 看到就不报这个 agent 的 agent_gone / ws_broken。"""
    d = os.environ.get("AGENT_STOP_DIR") or os.path.expanduser("~/.orca-state/agent-stops")
    keep = float(os.environ.get("STOP_KEEP_H", "48")) * 3600
    out = []
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out
    for f in names:
        if not f.endswith(".json"):
            continue
        try:
            m = json.load(open(os.path.join(d, f), encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(m, dict) and time.time() - (m.get("ts") or 0) < keep:
            out.append({k: m.get(k) for k in ("pid", "start", "name", "pane", "cwd", "ts", "by", "reason")})
    return out


def wake_facts():
    keep = float(os.environ.get("STOP_KEEP_H", "48")) * 3600
    sd = os.environ.get("ORCA_WAKE_STATE_DIR") or os.path.expanduser("~/.local/state/orca-wake")
    nl = os.environ.get("NOTIFY_RUN_LOG") or os.path.expanduser("~/.orca-state/notify-run/notify-run.log")
    sessions, nr = [], []
    try:
        names = os.listdir(os.path.join(sd, "sessions"))
    except OSError:
        names = []
    for f in names:
        path = os.path.join(sd, "sessions", f)
        try:
            if time.time() - os.path.getmtime(path) > keep:
                continue
            d = json.load(open(path, encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if not isinstance(d, dict) or not d.get("cwd"):
            continue
        sessions.append({"agent": d.get("agent"), "cwd": d["cwd"], "turn": str(d.get("turn", 0)),
                         "woken": str(d.get("turn", 0)) in (d.get("woken") or {}), "last_event": d.get("last_event"),
                         "last_event_ts": d.get("last_event_ts"), "agent_pid": d.get("agent_pid"),
                         "orca_terminal": d.get("orca_terminal"), "bot": d.get("bot")})
    try:
        lines = open(nl, encoding="utf-8", errors="replace").read().splitlines()[-400:]
    except OSError:
        lines = []
    for ln in lines:
        c = ln.split("\t")
        try:
            ts = datetime.datetime.strptime(c[0], "%Y-%m-%dT%H:%M:%S%z").timestamp()
        except (ValueError, IndexError):
            continue
        f = dict(x.split("=", 1) for x in c[1:] if "=" in x)
        nr.append({"ts": ts, "bot": f.get("bot"), "status": f.get("status"), "http": f.get("http"), "try": f.get("try"),
                   "ws": f.get("ws"), "pane": f.get("pane") if f.get("pane") not in (None, "-") else None,
                   "agent": f.get("agent") == "1"})
    return {"sessions": sessions, "nr": nr}


def main():
    r = subprocess.run(["ps", "-axo", "pid=,ppid=,stat=,etime=,args="], capture_output=True, text=True, timeout=30)
    procs = {}
    for ln in r.stdout.splitlines():
        f = ln.split(None, 4)
        if len(f) < 5:
            continue
        try:
            pid, ppid = int(f[0]), int(f[1])
        except ValueError:
            continue
        kind, name = classify(f[4])
        procs[pid] = {"pid": pid, "ppid": ppid, "stat": f[2], "etime_s": etime_s(f[3]), "kind": kind, "name": name}
        if kind:
            procs[pid]["_args"] = f[4]
        elif re.search(r"(?:^|/)(?:orca|orca-ide|Orca)(?:\s|$)", f[4].split(" --")[0]):
            procs[pid]["_orca"] = True
        if kind == "notify-run":
            m = re.search(r"(?:^|\s)--bot\s+([A-Za-z0-9._-]+)", f[4])
            procs[pid]["bot"] = m.group(1) if m else None
    keep = [p for p in procs.values() if p["kind"]]
    cwd = cwds_of([p["pid"] for p in keep])
    pane = panes_of([p["pid"] for p in keep])

    def ancestors(pid):
        seen, cur = set(), procs.get(pid, {}).get("ppid")
        while cur and cur in procs and cur not in seen:
            seen.add(cur)
            yield procs[cur]
            cur = procs[cur]["ppid"]

    wrappers = set()
    for p in keep:
        p["cwd"] = cwd.get(p["pid"])
        anc = list(ancestors(p["pid"]))
        p["agent_anc_cwds"] = [cwd[a["pid"]] for a in anc if a["kind"] == "agent" and a["pid"] in cwd]
        p["notify_anc"] = any(a["kind"] == "notify-run" for a in anc)
        p["pane"] = pane.get(p["pid"])
        p["in_orca"] = bool(p["pane"]) or any(a.get("_orca") for a in anc)
        if p["kind"] == "agent":
            wrappers.update(a["pid"] for a in anc if a["kind"] == "notify-run")
            p["dispatch_bot"] = next((a.get("bot") for a in anc if a["kind"] == "notify-run" and a.get("bot")), None)
            if not p["notify_anc"] and not p["agent_anc_cwds"]:
                p["args_head"] = " ".join(p["_args"].split())[:400]
    for p in keep:
        p["wraps_agent"] = p["pid"] in wrappers
        p.pop("_args", None)
    doc = {"host": socket.gethostname(), "ts": int(time.time()), "procs": keep, "stops": stop_marks(), "wake": wake_facts()}
    if "--plain" in sys.argv[1:]:
        print(json.dumps(doc, ensure_ascii=False, indent=1))
        return
    b = base64.b64encode(gzip.compress(json.dumps(doc, ensure_ascii=False).encode())).decode()
    print("@@PROBE-BEGIN")
    for i in range(0, len(b), 76):
        print(b[i:i + 76])
    print("@@PROBE-END")


main()
