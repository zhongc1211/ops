#!/bin/bash
# lock-held-alert /usr/bin/lockf -k -t 0 <锁文件> <命令> [参数...]
# 给 heartbeat-watch 的 precheck 用（B1，automations/heartbeat-1021/）：照原样跑后面的 lockf 命令，退出码照 lockf 的交出去；
# 另外看着「锁一直被占着」（FAILURE-MODES.md A41–A54）：
#   - lockf 退出 75（锁被上一轮或别的进程拿着，这一轮没起命令）：在锁文件旁边的 <锁文件>.skips.json 记下这一串跳过的
#     第一次时间和次数。从第一次跳过起满 HB_LOCK_ALERT_MIN（默认 45）分钟的那一轮报警一次（kind heartbeat_stale），之后不重复报。
#   - 拿到锁的那一轮跑完：清掉它开始以前就有的记录，报过警的再报一次「已恢复」（kind heartbeat_recovered）。
#     它开始以后才有的记录（它拿着锁时被挡下的几轮）不动，留给下一个拿到锁的。
#   - 跳过的、清掉记录的那一轮在 stdout 打一行；锁空着、没有记录时什么都不打。
#     不打 @@HB：跳过的一轮打了 @@HB，对面的 heartbeat-watch 会当这边还活着（F34）。
# 收件 bot 和 heartbeat-watch 一样是 coding-assistant；STUCK_FORCE_BOT、STUCK_WEBHOOK_DIR 照样生效。URL 和 KEY 只经 stdin 交给 curl。
# 每轮只发一次（curl 最多 20 秒），没发出去下一轮再发：heartbeat-watch 的重试最长要等 65 秒，拿到锁的那一轮放不下
# （MBA 那条最坏约 296 秒，超时 330）。不看 --dry-run，那是给 heartbeat-watch 的。
# 退出码：lockf 的（75 拿不到锁、73 打不开锁文件、其余是命令的；lockf 被信号杀掉时 128 + 信号）；用法错 64；起不了 lockf 71。
# 自己出错（状态文件读写、发告警）只在 stderr 写一行，退出码还是 lockf 的。73、64、71 不计数也不清记录：锁文件打不开时状态文件也写不了。
set -u
PY=$(command -v python3 || echo /usr/bin/python3)
exec "$PY" - "$@" <<'PYEOF'
import datetime, json, os, re, socket, subprocess, sys, tempfile, time

HOME = os.path.expanduser("~")
ARGS = sys.argv[1:]
if ARGS[:4] != ["/usr/bin/lockf", "-k", "-t", "0"] or len(ARGS) < 6:
    print("用法：lock-held-alert /usr/bin/lockf -k -t 0 <锁文件> <命令> [参数...]", file=sys.stderr)
    sys.exit(64)
LOCK = ARGS[4]
SHOW = "~" + LOCK[len(HOME):] if LOCK.startswith(HOME + "/") else LOCK
STATE_FILE = LOCK + ".skips.json"
WHAT = os.path.basename(ARGS[5])
TARGETS = [ARGS[i + 1].split("|")[0] for i in range(5, len(ARGS) - 1) if ARGS[i] == "--target"]
WEBHOOK_DIR = os.environ.get("STUCK_WEBHOOK_DIR") or os.path.join(HOME, ".config/grokbot/webhooks")
FORCE_BOT = os.environ.get("STUCK_FORCE_BOT")
BOT = "coding-assistant"
HOST = socket.gethostname().split(".")[0] or "本机"
SGT = datetime.timezone(datetime.timedelta(hours=8))
SECRETS = []


def say(msg, err=False):
    for s in SECRETS:
        msg = msg.replace(s, "<已隐藏>")
    print("%s lock-held-alert：%s" % (datetime.datetime.now(SGT).strftime("%F %T SGT"), msg),
          file=sys.stderr if err else sys.stdout, flush=True)


def alert_min():
    v = os.environ.get("HB_LOCK_ALERT_MIN")
    try:
        m = float(v) if v else 45.0
    except ValueError:
        m = -1.0
    if not m >= 0:  # 也挡住 nan
        say("HB_LOCK_ALERT_MIN=%s 不能用，按 45 分钟" % v, err=True)
        m = 45.0
    return m


ALERT_MIN = alert_min()


def fmt(t):
    return datetime.datetime.fromtimestamp(t, SGT).strftime("%m-%d %H:%M:%S")


def load_state():
    """读不到、不是 JSON、不是 dict 都当成没有记录；只留认识的数字字段。"""
    try:
        d = json.load(open(STATE_FILE, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(d, dict):
        return {}
    return {k: v for k, v in d.items()
            if k in ("first", "last", "skips", "alerted") and isinstance(v, (int, float)) and not isinstance(v, bool)}


def save_state(st):
    tmp = "%s.%d.tmp" % (STATE_FILE, os.getpid())  # 按进程取名，两轮同时写也不会写坏（A50）
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(st, f)
        os.replace(tmp, STATE_FILE)
    finally:
        try:
            os.remove(tmp)
        except FileNotFoundError:
            pass


def remove_state():
    try:
        os.remove(STATE_FILE)
    except FileNotFoundError:
        pass


def read_env(path):  # 同 heartbeat-watch.sh
    cfg = {}
    try:
        for ln in open(path):
            m = re.match(r"\s*(?:export\s+)?(URL|KEY)\s*=\s*(.*?)\s*$", ln)
            if m:
                cfg[m.group(1)] = m.group(2).strip("'\"")
    except OSError:
        return None
    SECRETS.extend(v for v in cfg.values() if v and v not in SECRETS)
    return cfg if cfg.get("URL") and cfg.get("KEY") else None


def post(payload):
    """发一次。返回（发出去没有，说明）。"""
    to = FORCE_BOT or BOT
    cfg = read_env(os.path.join(WEBHOOK_DIR, to + ".env")) if re.fullmatch(r"[A-Za-z0-9._-]+", to) else None
    if cfg is None:
        return False, "没有 %s 的 webhook 配置" % to
    payload = dict(payload, bot=to)
    esc = lambda v: v.replace("\\", "\\\\").replace('"', '\\"')
    conf = 'url = "%s"\nheader = "Content-Type: application/json"\nheader = "Authorization: Bearer %s"\n' % (
        esc(cfg["URL"]), esc(cfg["KEY"]))
    with tempfile.NamedTemporaryFile("w", suffix=".json", encoding="utf-8") as body:
        json.dump(payload, body, ensure_ascii=False)
        body.flush()
        try:
            p = subprocess.run(["curl", "-sS", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "20", "-X", "POST",
                                "--data-binary", "@" + body.name, "-K", "-"], input=conf, capture_output=True,
                               text=True, timeout=30)
            code = p.stdout.strip()
        except (OSError, subprocess.TimeoutExpired) as e:
            code = type(e).__name__
    return bool(re.fullmatch(r"2\d\d", code or "")), "POST %s → %s → %s" % (payload["kind"], to, code or "无响应")


def skipped(st, now):
    st["first"] = st.get("first") or now
    st["skips"] = int(st.get("skips") or 0) + 1
    st["last"] = now
    mins = (now - st["first"]) / 60.0
    msg = "锁被占着，这一轮没起 %s；已连续跳过 %d 轮（从 %s 起 %.1f 分钟，锁文件 %s）" % (
        WHAT, st["skips"], fmt(st["first"]), mins, SHOW)
    if st.get("alerted"):
        msg += "；%s 已报过，不重复报" % fmt(st["alerted"])
    elif mins >= ALERT_MIN:
        ok, how = post({"task": "检查任务没在跑：%s 上的 %s（锁一直被占着）" % (HOST, WHAT), "worktree": HOST,
                        "status": "stuck", "kind": "heartbeat_stale", "machine": HOST, "source": "lock-held-alert",
                        "note": "%s 上 %s 的锁 %s 从 %s 起一直被占着，已连续跳过 %d 轮（%.1f 分钟，阈值 %g 分钟），"
                                "这段时间没在查：%s。去那台机器用 `lsof %s` 看谁拿着锁。锁放开以后自动恢复，恢复时再报一次。" % (
                                    HOST, WHAT, SHOW, fmt(st["first"]), st["skips"], mins, ALERT_MIN,
                                    "、".join("「%s」" % t for t in TARGETS) or "（命令里没有 --target）", SHOW)})
        if ok:
            st["alerted"] = now
            msg += "；到了 %g 分钟，报警：%s" % (ALERT_MIN, how)
        else:
            msg += "；到了 %g 分钟，报警没发出去（%s），下一轮再发" % (ALERT_MIN, how)
    else:
        msg += "；到 %g 分钟才报" % ALERT_MIN
    say(msg)
    save_state(st)


def got_lock(st, rc, now, start):
    if not st or (st.get("first") or 0) >= start:
        return
    if st.get("skips"):
        msg = "锁拿到了，之前连续跳过 %d 轮（从 %s 起 %.1f 分钟，锁文件 %s）；这一轮 %s 退出 %d" % (
            st["skips"], fmt(st.get("first") or now), (now - (st.get("first") or now)) / 60.0, SHOW, WHAT, rc)
    else:
        msg = "锁拿到了（锁文件 %s）；这一轮 %s 退出 %d" % (SHOW, WHAT, rc)
    if not st.get("alerted"):
        say(msg)
        remove_state()
        return
    ok, how = post({"task": "检查任务已恢复：%s 上的 %s（锁放开了）" % (HOST, WHAT), "worktree": HOST,
                    "status": "recovered", "kind": "heartbeat_recovered", "machine": HOST, "source": "lock-held-alert",
                    "note": "%s 上 %s 的锁 %s 拿到了，这一轮退出 %d。%s 报过锁一直被占着%s。" % (
                        HOST, WHAT, SHOW, rc, fmt(st["alerted"]),
                        "（从 %s 起连续跳过 %d 轮）" % (fmt(st["first"]), st["skips"]) if st.get("skips") and st.get("first")
                        else "")})
    if ok:
        say(msg + "；%s 报过的锁被占着，已报恢复：%s" % (fmt(st["alerted"]), how))
        remove_state()
    else:
        say(msg + "；%s 报过的锁被占着，「已恢复」没发出去（%s），下一次拿到锁再发" % (fmt(st["alerted"]), how))
        save_state({"alerted": st["alerted"]})


start = time.time()
try:
    p = subprocess.Popen(ARGS, stdin=subprocess.DEVNULL)
except OSError as e:
    print("lock-held-alert：起不了 %s：%s" % (ARGS[0], e), file=sys.stderr)
    sys.exit(71)
rc = p.wait()
if rc < 0:
    rc = 128 - rc
if rc not in (64, 71, 73):
    try:
        if rc == 75:
            skipped(load_state(), time.time())
        else:
            got_lock(load_state(), rc, time.time(), start)
    except Exception as e:
        say("出错（退出码照旧 %d）：%s: %s" % (rc, type(e).__name__, e), err=True)
sys.exit(rc)
PYEOF
