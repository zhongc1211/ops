>     _log("search %s outcome=ok ms=%d %s atomic_facts=%d foreign_dropped=%d" % (
>         meta, (time.monotonic() - t0) * 1000, counts, facts, dropped))
>     return data
> _fmt_ep = server._fmt_episode
