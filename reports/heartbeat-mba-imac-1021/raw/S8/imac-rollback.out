# register.sh imac --stage rollback：1 条命令，dry-run，不调用 orca
# 先备份：mkdir -p ~/ops-archive/heartbeat-1021 && orca automations show --id 5c2d0575-dddc-4d5c-8f73-e47b26ea9a11 --json > ~/ops-archive/heartbeat-1021/5c2d0575-dddc-4d5c-8f73-e47b26ea9a11.before-rollback.json
# imac-5c2d-rollback：back to the live config of 2026-10-21 (= before); re-enable box 94e4b0bc first (README 回滚)
orca automations edit 5c2d0575-dddc-4d5c-8f73-e47b26ea9a11 --name 'ops · 29 心跳互查（盯 box ops · 29）' --precheck '$HOME/.orca-state/bin/heartbeat-watch.sh --precheck --target "box ops · 29 卡住检查心跳|grok-bot|94e4b0bc-0f9d-4cf2-a1fd-2282a888fe80|20"' --precheck-timeout 240
# 跑这一条之前，先重新启用 box 的旧看守、等它第一次运行正常（README 回滚表）：
#   orca automations edit 94e4b0bc-0f9d-4cf2-a1fd-2282a888fe80 --environment grok-bot --enabled
