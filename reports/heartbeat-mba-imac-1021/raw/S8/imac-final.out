# register.sh imac --stage final：1 条命令，dry-run，不调用 orca
# 先备份：mkdir -p ~/ops-archive/heartbeat-1021 && orca automations show --id 5c2d0575-dddc-4d5c-8f73-e47b26ea9a11 --json > ~/ops-archive/heartbeat-1021/5c2d0575-dddc-4d5c-8f73-e47b26ea9a11.before-final.json
# imac-5c2d-final：after the parallel night: drop the box target before box 94e4b0bc is disabled; the rename is not in the brief, drop 'name' here if it is not wanted
orca automations edit 5c2d0575-dddc-4d5c-8f73-e47b26ea9a11 --name 'ops · 29 心跳互查（盯 MBA ops · 29）' --precheck '$HOME/.orca-state/bin/heartbeat-watch.sh --precheck --target "MBA ops · 29 心跳互查|mba|11111111-2222-3333-4444-555555555555|20"' --precheck-timeout 240
# 这一条生效后，在 iMac 上先备份、再停 box 的旧看守（README 第 6 步；在 box 上跑就去掉 --environment grok-bot）：
#   orca automations show --id 94e4b0bc-0f9d-4cf2-a1fd-2282a888fe80 --environment grok-bot --json > ~/ops-archive/heartbeat-1021/94e4b0bc-0f9d-4cf2-a1fd-2282a888fe80.before.json
#   orca automations edit 94e4b0bc-0f9d-4cf2-a1fd-2282a888fe80 --environment grok-bot --disabled
