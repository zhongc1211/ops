# register.sh imac --stage final：1 条命令，dry-run，不调用 orca
# 先备份：mkdir -p ~/ops-archive/heartbeat-1021 && orca automations show --id 5c2d0575-dddc-4d5c-8f73-e47b26ea9a11 --json > ~/ops-archive/heartbeat-1021/5c2d0575-dddc-4d5c-8f73-e47b26ea9a11.before-final.json
# imac-5c2d-final：after the parallel night: drop the box target before box 94e4b0bc is disabled; keep lockf and lock-held-alert with the same lock file as the parallel stage (a round that outlives the 5 min schedule must not run next to the next one); one target, worst 286 s plus about 4 s to start = 290 s, so 300 stays, about 10 s to spare. A round that reports recovery after a lock-held alert posts once more (curl at most 20 s), about 310 s: Orca kills it and records a timeout; lock-held-alert writes the pending recovery to the state file before posting, so a later round sends it (README 已知限制). Nobody watches 5c2d0575: when its lock stays held, its own lock-held alert (to ops-system) is the only report. The rename is not in the brief, drop 'name' here if it is not wanted
orca automations edit 5c2d0575-dddc-4d5c-8f73-e47b26ea9a11 --name 'ops · 29 心跳互查（盯 MBA ops · 29）' --precheck '$HOME/.orca-state/bin/lock-held-alert /usr/bin/lockf -k -t 0 $HOME/.orca-state/heartbeat-watch/5c2d0575.lock $HOME/.orca-state/bin/heartbeat-watch.sh --precheck --target "MBA ops · 29 心跳互查|mba|11111111-2222-3333-4444-555555555555|20"' --precheck-timeout 300
# 这一条生效后，在 iMac 上先备份、再停 box 的旧看守（README 第 6 步；在 box 上跑就去掉 --environment grok-bot）：
#   orca automations show --id 94e4b0bc-0f9d-4cf2-a1fd-2282a888fe80 --environment grok-bot --json > ~/ops-archive/heartbeat-1021/94e4b0bc-0f9d-4cf2-a1fd-2282a888fe80.before.json
#   orca automations edit 94e4b0bc-0f9d-4cf2-a1fd-2282a888fe80 --environment grok-bot --disabled
