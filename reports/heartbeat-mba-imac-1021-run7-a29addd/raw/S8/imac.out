# register.sh imac --stage parallel：1 条命令，dry-run，不调用 orca
# 先备份：mkdir -p ~/ops-archive/heartbeat-1021 && orca automations show --id 5c2d0575-dddc-4d5c-8f73-e47b26ea9a11 --json > ~/ops-archive/heartbeat-1021/5c2d0575-dddc-4d5c-8f73-e47b26ea9a11.before.json
# imac-5c2d-parallel：one night with both watchers: keep the box target as it is (checked first, unchanged) and add the MBA task; two targets read through Orca environments (no ssh cap): worst 2 x 286 s = 572 s, so 600 (Orca's maximum). 600 s is longer than the 5 min schedule, so the precheck runs under /usr/bin/lockf -k -t 0 with its own lock file, as the MBA task does (the directory already exists on the iMac)
# 没给 --mba-id：下面的命令里是占位「<MBA 新任务 id>」，不能照抄执行
orca automations edit 5c2d0575-dddc-4d5c-8f73-e47b26ea9a11 --precheck '/usr/bin/lockf -k -t 0 $HOME/.orca-state/heartbeat-watch/5c2d0575.lock $HOME/.orca-state/bin/heartbeat-watch.sh --precheck --target "box ops · 29 卡住检查心跳|grok-bot|94e4b0bc-0f9d-4cf2-a1fd-2282a888fe80|20" --target "MBA ops · 29 心跳互查|mba|<MBA 新任务 id>|20"' --precheck-timeout 600
# 之后并行一晚（README 第 5 步），第二天看两边的运行记录再走 final。
