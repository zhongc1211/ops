#!/bin/bash
# orca-agent-launch --bot <bot> --task "<描述>" [--issue X --eta <YYYY-MM-DD[ HH:MM]>] [--no-linear] -- <claude|pi|codex> [参数...]
# 统一的起 agent 入口（PER-65）：一律经 notify-run --tty 起，agent 做完、停下、被杀都会叫醒派活的 bot。
# 派活时把它当 Orca 终端的命令：
#   orca terminal create --worktree <wt> --command "orca-agent-launch --bot coding-assistant --task 'PER-65 xxx' -- claude --dangerously-skip-permissions '读 BRIEF 并照做'"
# 拒绝（退出码 2，什么都不起）：
#   - 没带 --bot 或 --task（等于没包 notify-run）；
#   - bot 名不合法，或没有它的 webhook 配置（~/.config/grokbot/webhooks/<bot>.env，叫醒发不出去）；
#   - 要起的不是 claude / pi / codex，或者经 bash -c、env、nohup 之类转一层（agent 必须是 notify-run 的直接子进程，
#     否则 orca-wake 按 parent_mismatch 跳过）；
#   - 已经在一个 notify-run 里（ORCA_DISPATCH_PID 还活着）：嵌套起的 agent 不会被当成派出的主会话；
#   - 启动前检查（PER-80）：agent 起来后会加载的指令文件里没有一个含标记句「NEVER write unit tests」，
#     或者链上有文件读不了、一个文件都没有。stderr 列出查过的每个文件，并写明应当包含标记句的文件。没有绕过开关。
# 带 --issue 时（PER-66）：起 agent 之前顺手给 Linear issue 写负责 bot 和 due，卡住检查的 due 对账才有东西可查：
#   - due = --eta 的日期（新加坡时间；只写日期，Linear 的 due 没有时刻）。带 --issue 必须带 --eta，否则拒绝（退出码 2）；
#   - 负责 bot：描述里没有「负责 bot：<bot>」这一行就在末尾补一行；写着别的 bot 时改成这次的（stuck-check 的 due_bot 认这一行）。
#   Linear 写不进去时拒绝起 agent（退出码 3），确认要先起再补卡时加 --no-linear。
# 拒绝时（退出码 2 / 3）同时叫醒派活的 bot：status stuck、kind agent_not_started，note 写拒绝原因（PER-67 第 6 组：10-19 07:24 iMac
#   一次 --eta 写成 09:30 被拒，agent 没起来，没有 notify-run 也没有任何会话，谁都不知道）。--bot 不合法或没有它的 webhook、或者发不出去时
#   改发 coding-assistant。只发一次，不重试；ORCA_AGENT_LAUNCH_DRY=1 时不发。
# 通过检查后 exec notify-run，退出码就是 notify-run 的（即 agent 的）退出码。
# 测试用环境变量：ORCA_AGENT_LAUNCH_NOTIFY_RUN（notify-run 路径）、ORCA_AGENT_LAUNCH_WEBHOOK_DIR（webhook 目录）、
#   ORCA_AGENT_LAUNCH_DRY=1（只打印将要执行的命令，不写 Linear）、ORCA_AGENT_LAUNCH_ORCA（orca CLI 路径）。
set -u

# 测试时只认 ORCA_AGENT_LAUNCH_WEBHOOK_DIR，不退回 /home/box 下的真配置
webhook_env() {  # $1=bot → 能读的 env 文件路径
    if [ -n "${ORCA_AGENT_LAUNCH_WEBHOOK_DIR:-}" ]; then
        [ -r "$ORCA_AGENT_LAUNCH_WEBHOOK_DIR/$1.env" ] && echo "$ORCA_AGENT_LAUNCH_WEBHOOK_DIR/$1.env"
    elif [ -r "$HOME/.config/grokbot/webhooks/$1.env" ]; then
        echo "$HOME/.config/grokbot/webhooks/$1.env"
    elif [ -r "/home/box/.config/grokbot/webhooks/$1.env" ]; then
        echo "/home/box/.config/grokbot/webhooks/$1.env"
    fi
}
send_reject() (  # $1=bot $2=说明；子 shell 里读 env 文件，KEY 不留在主进程里。送达返回 0
    set +x
    env_file=$(webhook_env "$1") && [ -n "$env_file" ] || exit 1
    URL="" KEY=""
    . "$env_file"
    [ -n "$URL" ] && [ -n "$KEY" ] || exit 1
    body=$(python3 -c 'import json, socket, sys
a = sys.argv[1:]
print(json.dumps({"bot": a[0], "task": a[1], "issue": a[2], "machine": socket.gethostname(), "status": "stuck",
                  "kind": "agent_not_started", "source": "orca-agent-launch", "worktree": a[3], "orca_terminal": a[4],
                  "note": a[5]}, ensure_ascii=False))' "$1" "${task:-?}" "${issue:-}" "$PWD" "${ORCA_TERMINAL_HANDLE:-}" "$2") || exit 1
    http=$(printf 'Authorization: Bearer %s\n' "$KEY" | curl -sS -o /dev/null -w '%{http_code}' --max-time 20 -X POST -H @- \
        -H 'Content-Type: application/json' --data-binary "$body" "$URL" 2>/dev/null)
    /bin/echo "orca-agent-launch: 已把拒绝原因发给 $1（http=${http:-无响应}）" >&2 2>/dev/null || true
    case "$http" in 2??) exit 0 ;; esac
    exit 1
)
wake_reject() {  # $1=拒绝原因
    [ "${ORCA_AGENT_LAUNCH_DRY:-}" = 1 ] && return 0
    local to=coding-assistant note
    note="orca-agent-launch 拒绝：$1。agent 没起来（没有 notify-run，也不会有完工叫醒）；改好命令重新起"
    case "${bot:-}" in ""|*[!A-Za-z0-9._-]*|.*) ;; *) [ -n "$(webhook_env "$bot")" ] && to=$bot ;; esac
    send_reject "$to" "$note" && return 0
    [ "$to" = coding-assistant ] || send_reject coding-assistant "${note}（原本发给 ${to}，没发出去）" || true
}
die() { echo "orca-agent-launch: 拒绝：$*" >&2; wake_reject "$*"; exit 2; }
usage_text() { echo "用法: orca-agent-launch --bot <bot> --task \"<描述>\" [--issue X --eta <YYYY-MM-DD[ HH:MM]>] [--no-linear] -- <claude|pi|codex> [参数...]" >&2; }
usage() { usage_text; wake_reject "用法错误（参数不全）"; exit 2; }

bot="" task="" issue="" eta="" no_linear=""
while [ $# -gt 0 ]; do
    case "$1" in
        --bot)   [ $# -ge 2 ] || usage; bot=$2; shift 2 ;;
        --task)  [ $# -ge 2 ] || usage; task=$2; shift 2 ;;
        --issue) [ $# -ge 2 ] || usage; issue=$2; shift 2 ;;
        --eta)   [ $# -ge 2 ] || usage; eta=$2; shift 2 ;;
        --no-linear) no_linear=1; shift ;;
        --)      shift; break ;;
        -h|--help) usage_text; exit 2 ;;
        *)       break ;;
    esac
done
[ $# -gt 0 ] || usage
[ -n "$bot" ] || die "没带 --bot：agent 必须经 notify-run 起，做完才会叫醒派活的 bot"
[ -n "$task" ] || die "没带 --task"
case "$bot" in
    *[!A-Za-z0-9._-]*|.*) die "bot 名不合法：$bot" ;;
esac
wdir=${ORCA_AGENT_LAUNCH_WEBHOOK_DIR:-$HOME/.config/grokbot/webhooks}
[ -n "$(webhook_env "$bot")" ] || die "没有 $bot 的 webhook 配置（$wdir/$bot.env），叫醒发不出去"
agent=$(basename -- "$1")
case "$agent" in
    claude|pi|codex) ;;
    bash|sh|zsh|dash|env|nohup|setsid|exec|timeout|nice|sudo|script)
        die "不要经 $agent 转一层：agent 必须是 notify-run 的直接子进程（写成 -- claude ...）" ;;
    notify-run) die "已经由 orca-agent-launch 包 notify-run 了，直接写 -- claude ..." ;;
    *) die "只起 claude / pi / codex，不认识：$agent" ;;
esac
command -v -- "$1" >/dev/null 2>&1 || die "找不到命令：$1"
# 启动前检查的一部分：这些参数让 agent 不加载指令文件，规矩文件再全也读不到（已装版本 --help 里核实过）
for a in "$@"; do
    case "$agent:$a" in
        claude:--bare) die "claude --bare 跳过 CLAUDE.md 自动发现，agent 起来读不到规矩；去掉 --bare" ;;
        pi:--no-context-files|pi:-nc) die "pi ${a} 不读 AGENTS.md / CLAUDE.md，agent 起来读不到规矩；去掉 ${a}" ;;
    esac
done
if [ -n "${ORCA_DISPATCH_PID:-}" ] && kill -0 "$ORCA_DISPATCH_PID" 2>/dev/null; then
    die "已经在 notify-run（pid ${ORCA_DISPATCH_PID}）里面，嵌套起的 agent 不算派出的主会话；请在新终端里起"
fi
due=""
if [ -n "$issue" ]; then
    case "$issue" in
        [A-Za-z]*-[0-9]*) ;;
        *) die "--issue 要写 Linear 编号（如 PER-66）：$issue" ;;
    esac
    [ -n "$eta" ] || [ -n "$no_linear" ] || die "带 --issue 要同时带 --eta（预计完成时间，写进 Linear 的 due），或者加 --no-linear"
    if [ -n "$eta" ]; then
        due=$(printf '%s' "$eta" | grep -Eo '^[0-9]{4}-[0-9]{2}-[0-9]{2}') || die "--eta 要以 YYYY-MM-DD 开头：$eta"
    fi
elif [ -n "$eta" ]; then
    die "--eta 只和 --issue 一起用"
fi
unset ORCA_DISPATCH_PID ORCA_DISPATCH_BOT ORCA_TASK_ID ORCA_DISPATCH_ISSUE ORCA_DISPATCH_TS
nr=${ORCA_AGENT_LAUNCH_NOTIFY_RUN:-$(command -v notify-run || echo "$HOME/.local/bin/notify-run")}
[ -x "$nr" ] || die "找不到 notify-run（${nr}）"
cmd=("$nr" --bot "$bot" --task "$task")
[ -n "$issue" ] && cmd+=(--issue "$issue")
# 决定 5A：仅本入口启动的 Claude 会话禁用 superpowers，不写用户设置。
# 合并已有 --settings（文件或 inline JSON），避免重复参数把调用方设置丢掉。
# 在构造命令时完成，dry-run 也展示同一份参数；pi/codex 原样转发。
if [ "$agent" = claude ]; then
    claude_bin=$1; shift
    claude_args=()
    session_settings='{}'
    seen_settings=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --) claude_args+=("$@"); break ;;
            --settings|--settings=*)
                [ "$seen_settings" = 0 ] || die "只接受一个 --settings，请先合并设置"
                seen_settings=1
                if [ "$1" = --settings ]; then
                    [ $# -ge 2 ] || die "--settings 缺少值"
                    session_settings=$2; shift 2
                else
                    session_settings=${1#--settings=}; shift
                fi ;;
            *) claude_args+=("$1"); shift ;;
        esac
    done
    # 固定 /tmp，不接受可能指向永久目录的 TMPDIR。macOS 的系统
    # com.apple.tmp_cleaner 每天清理 /tmp 的过期内容；不是进程退出即删。
    # mktemp 创建 0600 文件，不改变 notify-run -> claude 的直接父子关系。
    session_settings_file=$(mktemp /tmp/orca-claude-settings.XXXXXX) || die "建不了会话设置文件"
    trap 'rm -f -- "$session_settings_file"' EXIT
    python3 - "$session_settings" "$session_settings_file" <<'PY'
import json, pathlib, sys
try:
    raw = sys.argv[1]
    data = json.loads(raw) if raw.lstrip().startswith('{') else json.loads(pathlib.Path(raw).read_text())
    if not isinstance(data, dict):
        raise ValueError('settings must be an object')
    plugins = data.setdefault('enabledPlugins', {})
    if not isinstance(plugins, dict):
        raise ValueError('enabledPlugins must be an object')
    plugins['superpowers@claude-plugins-official'] = False
    # 文件输入也不展开到 argv/日志。mktemp 权限 0600；exec 后保留供会话读取。
    with open(sys.argv[2], 'w') as f:
        json.dump(data, f, ensure_ascii=False)
        f.write('\n')
except Exception:
    # 不打印调用方设置值：其中可能有凭据。
    sys.exit('无法读取或合并 --settings；没有启动 Claude')
PY
    [ $? -eq 0 ] || die "无法合并 Claude 会话设置"
    # 未启动（dry-run/Linear 拒绝/exec 失败）时清理。成功 exec 不跑 EXIT：
    # 由 macOS tmp_cleaner 延迟回收；会话结束后也可按打印路径提前删除。
    # 不按固定秒数提前删（无法确认 Claude 已读完且不会重读）。
    cmd+=(--tty -- "$claude_bin" --settings "$session_settings_file" ${claude_args[@]+"${claude_args[@]}"})
else
    cmd+=(--tty -- "$@")
fi
# 启动前检查（PER-80，审计缺口 G3）：agent 起来后实际会加载的指令文件里至少一个有标记句，否则拒绝。
# 只读，dry-run 也做；家目录一律用 $HOME，工作区用 $PWD。各 agent 读什么（10-30 在 iMac 上查的已装版本）：
#   claude（2.1.312，实测）：$CLAUDE_CONFIG_DIR 或 ~/.claude 下的 CLAUDE.md 和 rules/*.md、
#     工作区往上每一级（不含 /）的 CLAUDE.md、.claude/CLAUDE.md、.claude/rules/*.md、CLAUDE.local.md，
#     再展开里面的 @路径 引用（相对引用它的文件，~/ 是家目录，最多 5 层，代码块里的不算）。默认不读 AGENTS.md。
#   pi（1.4.0，dist/core/resource-loader.js）：$PI_CODING_AGENT_DIR 或 ~/.pi/agent，和工作区往上每一级（含 /），
#     每个目录取 AGENTS.override.md、AGENTS.md、AGENTS.MD、CLAUDE.md、CLAUDE.MD 里第一个存在的；
#     嵌套 worktree 里，主检出里被 worktree 同名文件遮住的那个不读。不展开 @。
#   codex（0.161.0）：$CODEX_HOME 或 ~/.codex，和从 git 根（最近一个有 .git 的上级）到工作区的每一级；
#     不在 git 里时只看工作区。每个目录取 AGENTS.override.md、AGENTS.md 里第一个存在的。
MARKER_PREFIX='NEVER write unit tests'  # 标记句前缀，以 iMac ~/.pi/agent/AGENTS.md 第 42 行为准；只在这里写一次
lc_out=$(mktemp "${TMPDIR:-/tmp}/orca-agent-launch.XXXXXX") || die "建不了临时文件"
python3 - "$agent" "$PWD" "$HOME" "$MARKER_PREFIX" >"$lc_out" <<'PY'
import os, re, sys
agent, cwd, home, marker = sys.argv[1:5]
cwd = os.path.realpath(cwd)  # agent 的 process.cwd() 是解析过符号链接的物理路径
env = os.environ.get
files, seen = [], set()  # files: [路径, 状态, 来源, 是否加载]

def add(path, why):
    """记一个 agent 会加载的文件，返回内容；不存在、读不了、已记过返回 None。"""
    key = os.path.realpath(path)
    if key in seen:
        return None
    seen.add(key)
    if not os.path.isfile(path):
        files.append([path, "不存在", why, False])
        return None
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError as e:
        files.append([path, "读不了（%s）" % (e.strerror or e), why, True])
        return None
    files.append([path, "有标记句" if marker in text else "没有标记句", why, True])
    return text

def first(d, names):
    for n in names:
        if os.path.isfile(os.path.join(d, n)):
            return os.path.join(d, n)
    return None

def ancestors(d, stop_at_root):  # 工作区往上，由近到远
    out = []
    while True:
        parent = os.path.dirname(d)
        if parent == d:
            if not stop_at_root:
                out.append(d)
            return out
        out.append(d)
        d = parent

skipped = 0
if agent == "claude":
    cfg = env("CLAUDE_CONFIG_DIR") or os.path.join(home, ".claude")
    rx = re.compile(r"(?:^|\s)@((?:[^\s\\]|\\ )+)")

    def imports(text, base):
        out, fence = [], None
        for line in text.splitlines():
            s = line.lstrip()
            if fence:
                if s.startswith(fence):
                    fence = None
                continue
            if s.startswith("```") or s.startswith("~~~"):
                fence = s[:3]
                continue
            for m in rx.finditer(re.sub(r"`[^`]*`", "", line)):
                p = m.group(1).replace("\\ ", " ")
                if p.startswith("~/"):
                    p = os.path.join(home, p[2:])
                elif not os.path.isabs(p):
                    p = os.path.join(base, p)
                out.append(os.path.normpath(p))
        return out

    def load(path, why, depth=0):
        text = add(path, why)
        if text is None or depth >= 5:
            return
        for p in imports(text, os.path.dirname(path)):
            load(p, "@ 引用自 %s" % path, depth + 1)

    def rules(d, why):  # rules/**/*.md，带 paths: 的按需加载，启动时不读
        for root, dirs, names in sorted(os.walk(os.path.join(d, "rules"))):
            for n in sorted(names):
                p = os.path.join(root, n)
                if not n.endswith(".md"):
                    continue
                try:
                    with open(p, encoding="utf-8", errors="replace") as f:
                        head = f.read(4096)
                except OSError:
                    head = ""
                if head.startswith("---") and re.search(r"^paths\s*:", head[3:head.find("\n---", 3)], re.M):
                    continue
                load(p, why)

    for p in ("/Library/Application Support/ClaudeCode/CLAUDE.md", "/etc/claude-code/CLAUDE.md"):
        if os.path.exists(p):
            load(p, "Claude Code 托管策略")
    load(os.path.join(cfg, "CLAUDE.md"), "Claude Code 用户级")
    rules(cfg, "Claude Code 用户级 rules")
    for d in reversed(ancestors(cwd, True)):
        for n in ("CLAUDE.md", os.path.join(".claude", "CLAUDE.md"), "CLAUDE.local.md"):
            p = os.path.join(d, n)
            if os.path.exists(p):
                load(p, "工作区或上级目录")
            else:
                skipped += 1
        rules(os.path.join(d, ".claude"), "工作区或上级目录的 .claude/rules")
    pi_global = os.path.join(home, ".pi", "agent", "AGENTS.md")
    try:
        with open(pi_global, encoding="utf-8", errors="replace") as f:
            pi_has = marker in f.read()
    except OSError:
        pi_has = False
    if pi_has and os.path.realpath(pi_global) not in seen:
        expect = "%s（加一行 @~/.pi/agent/AGENTS.md，引用全局 AGENTS）" % os.path.join(cfg, "CLAUDE.md")
    else:
        expect = "%s（全局规矩；%s 里用 @~/.pi/agent/AGENTS.md 引用它）" % (pi_global, os.path.join(cfg, "CLAUDE.md"))
    cands = "工作区往上各级的 CLAUDE.md、.claude/CLAUDE.md、CLAUDE.local.md"
elif agent == "pi":
    names = ["AGENTS.override.md", "AGENTS.md", "AGENTS.MD", "CLAUDE.md", "CLAUDE.MD"]
    agent_dir = env("PI_CODING_AGENT_DIR") or os.path.join(home, ".pi", "agent")
    g = first(agent_dir, names)
    expect = g or os.path.join(agent_dir, "AGENTS.md")
    add(expect, "pi 全局")

    def shadowed():  # 照 pi 的 findShadowedContextFile
        d = cwd
        while not os.path.exists(os.path.join(d, ".git")):
            if os.path.dirname(d) == d:
                return None
            d = os.path.dirname(d)
        g = os.path.join(d, ".git")
        try:
            content = open(g).read().strip() if os.path.isfile(g) else ""
        except OSError:
            return None
        if not content.startswith("gitdir: "):
            return None
        gitdir = os.path.normpath(os.path.join(d, content[8:].strip()))
        cd = os.path.join(gitdir, "commondir")
        common = os.path.normpath(os.path.join(gitdir, open(cd).read().strip())) if os.path.exists(cd) else gitdir
        common, wt = os.path.realpath(common), os.path.realpath(d)
        main = os.path.dirname(common)
        if not wt.startswith(main + os.sep) or os.path.realpath(os.path.join(main, ".git")) != common:
            return None
        f = first(wt, names)
        return os.path.join(main, os.path.basename(f)) if f else None

    try:
        sh = shadowed()
    except (OSError, ValueError):  # .git / commondir 读不了：当没有遮挡，多列不少列
        sh = None
    for d in reversed(ancestors(cwd, False)):
        p = first(d, names)
        if not p:
            skipped += 1
        elif sh and os.path.join(os.path.realpath(d), os.path.basename(p)) == sh:
            files.append([p, "pi 不读（被 worktree 里的同名文件遮住）", "工作区或上级目录", False])
        else:
            add(p, "工作区或上级目录")
    cands = "工作区往上各级的 AGENTS.override.md、AGENTS.md、CLAUDE.md"
else:  # codex
    names = ["AGENTS.override.md", "AGENTS.md"]
    codex_home = env("CODEX_HOME") or os.path.join(home, ".codex")
    expect = first(codex_home, names) or os.path.join(codex_home, "AGENTS.md")
    add(expect, "codex 全局")
    dirs = ancestors(cwd, False)
    root = next((i for i, d in enumerate(dirs) if os.path.exists(os.path.join(d, ".git"))), None)
    for d in reversed(dirs[:root + 1] if root is not None else dirs[:1]):
        p = first(d, names)
        if p:
            add(p, "git 根到工作区")
        else:
            skipped += 1
    cands = "git 根到工作区各级的 AGENTS.override.md、AGENTS.md"

loaded = [f for f in files if f[3]]
hits = [f[0] for f in loaded if f[1] == "有标记句"]
bad = [f for f in loaded if f[1].startswith("读不了")]
err = sys.stderr.write
err("启动检查：%s 在 %s 会加载的指令文件（标记句前缀「%s」）：\n" % (agent, cwd, marker))
for path, state, why, _ in files:
    err("  %-6s %s（%s）\n" % (state, path, why))
if skipped:
    err("  另查了 %d 个不存在的候选（%s）\n" % (skipped, cands))
if bad:
    print("启动检查：%s 指令链里 %s 读不了，agent 起来读不到它；应当包含标记句的文件：%s" % (agent, "、".join(f[0] for f in bad), expect))
    sys.exit(1)
if not loaded:
    print("启动检查：%s 指令链里一个文件都没有，agent 起来读不到任何规矩；应当包含标记句的文件：%s" % (agent, expect))
    sys.exit(1)
if not hits:
    print("启动检查：%s 指令链 %d 个文件都没有标记句「%s」；应当包含标记句的文件：%s" % (agent, len(loaded), marker, expect))
    sys.exit(1)
more = "（另有 %d 个文件也有）" % (len(hits) - 1) if len(hits) > 1 else ""
print("启动检查：%s 指令链 %d 个文件，标记句在 %s%s" % (agent, len(loaded), hits[0], more))
PY
lc_rc=$?
lc_msg=$(cat "$lc_out"); rm -f "$lc_out"
[ "$lc_rc" -eq 0 ] || die "${lc_msg:-启动检查出错（python3 退出码 ${lc_rc}）}"
echo "orca-agent-launch: $lc_msg" >&2
if [ "${ORCA_AGENT_LAUNCH_DRY:-}" = 1 ]; then
    [ -n "$issue" ] && [ -z "$no_linear" ] && echo "（会写 Linear ${issue}：due ${due}，负责 bot：${bot}）"
    printf '%q ' "${cmd[@]}"; echo
    exit 0
fi
if [ -n "$issue" ] && [ -z "$no_linear" ]; then
    orca=${ORCA_AGENT_LAUNCH_ORCA:-}
    [ -n "$orca" ] || orca=$(command -v orca-ide || command -v orca) || orca=""
    [ -n "$orca" ] || { [ -x "$HOME/.local/bin/orca" ] && orca=$HOME/.local/bin/orca; } ||
        orca=/Applications/Orca.app/Contents/Resources/bin/orca
    # 写 due，再补「负责 bot：」一行。失败就不起 agent：due 对账靠它。
    # Python 不放进 $(...) 里：/bin/bash 3.2 解析 $(...) 里的 here-doc 会出错（10-19 演练时整个脚本跑不起来）
    out=$(mktemp "${TMPDIR:-/tmp}/orca-agent-launch.XXXXXX") || die "建不了临时文件"
    python3 - "$orca" "$issue" "$due" "$bot" >"$out" <<'PY'
import json, re, subprocess, sys
orca, issue, due, bot = sys.argv[1:5]

def call(*args):
    p = subprocess.run([orca, "linear"] + list(args) + ["--json"], capture_output=True, text=True, timeout=60)
    try:
        d = json.loads(p.stdout)
    except ValueError:
        raise SystemExit("orca linear %s 没有返回 JSON：%s" % (args[0], (p.stderr or p.stdout).strip()[:200]))
    if not d.get("ok"):
        raise SystemExit("orca linear %s 失败：%s" % (args[0], json.dumps(d.get("error"), ensure_ascii=False)[:200]))
    return d.get("result") or {}

iss = call("issue", issue).get("issue") or {}
if not iss.get("identifier"):
    raise SystemExit("Linear 里找不到 %s" % issue)
call("due-date", "set", issue, "--to", due)
desc = iss.get("description") or ""
line = "负责 bot：%s" % bot
rx = re.compile(r"负责\s*bot\s*[:：]\s*([\w.\-]+)", re.I)
m = rx.search(desc)
if m and m.group(1) == bot:
    how = "描述里已有「%s」" % line
else:
    new = rx.sub(line, desc, count=1) if m else (desc.rstrip() + "\n\n" + line + "（orca-agent-launch 写入）").lstrip()
    call("save-issue", issue, "--description", new)
    how = "描述里%s「%s」" % ("把「负责 bot：%s」改成" % m.group(1) if m else "补了", line)
print("Linear %s：due 设为 %s；%s" % (iss["identifier"], due, how))
PY
    rc=$?
    msg=$(cat "$out"); rm -f "$out"
    if [ "$rc" -ne 0 ]; then
        echo "orca-agent-launch: 拒绝：Linear $issue 写不进去（见上）。确认要先起 agent 再补卡就加 --no-linear" >&2
        wake_reject "Linear $issue 写不进去（$(printf '%s' "$msg" | tail -1 | cut -c1-200)）"
        exit 3
    fi
    echo "orca-agent-launch: $msg" >&2
fi
[ "$agent" != claude ] || echo "orca-agent-launch: 本会话设置 ${session_settings_file}（0600；macOS 系统延迟清理，会话结束后可提前删除）" >&2
exec "${cmd[@]}"
