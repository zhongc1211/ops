#!/bin/bash
# orca-agent-launch --bot <bot> --task "<描述>" [--issue X --eta <YYYY-MM-DD[ HH:MM]>] [--no-linear] -- <claude|pi|codex> [参数...]
# 统一的起 agent 入口（PER-65）：一律经 notify-run --tty 起，agent 做完、停下、被杀都会叫醒派活的 bot。
# 派活时把它当 Orca 终端的命令：
#   orca terminal create --worktree <wt> --command "orca-agent-launch --bot coding-assistant --task 'PER-65 xxx' -- claude --dangerously-skip-permissions '读 BRIEF 并照做'"
# 拒绝（退出码 2，什么都不起）：
#   - 没带 --bot 或 --task（等于没包 notify-run）；
#   - bot 名不合法，或没有它的 webhook 配置（~/.config/grokbot/webhooks/<bot>.env，叫醒发不出去）；
#   - 要起的不是 claude / pi / codex，或者经 bash -c、env、nohup 之类转一层（agent 必须是 notify-run 的直接子进程，
#     否则 orca-wake 按 parent_mismatch 跳过）；
#   - 已经在一个 notify-run 里（ORCA_DISPATCH_PID 还活着）：嵌套起的 agent 不会被当成派出的主会话。
# 带 --issue 时（PER-66）：起 agent 之前顺手给 Linear issue 写负责 bot 和 due，卡住检查的 due 对账才有东西可查：
#   - due = --eta 的日期（新加坡时间；只写日期，Linear 的 due 没有时刻）。带 --issue 必须带 --eta，否则拒绝（退出码 2）；
#   - 负责 bot：描述里没有「负责 bot：<bot>」这一行就在末尾补一行；写着别的 bot 时改成这次的（stuck-check 的 due_bot 认这一行）。
#   Linear 写不进去时拒绝起 agent（退出码 3），确认要先起再补卡时加 --no-linear。
# 拒绝时（退出码 2 / 3）同时叫醒派活的 bot：status stuck、kind agent_not_started，note 写拒绝原因（PER-67 第 6 组：10-19 07:24 iMac
#   一次 --eta 写成 09:30 被拒，agent 没起来，没有 notify-run 也没有任何会话，谁都不知道）。--bot 不合法或没有它的 webhook、或者发不出去时
#   改发 coding-assistant。只发一次，不重试；ORCA_AGENT_LAUNCH_DRY=1 时不发。
# 通过检查后 exec notify-run，退出码就是 notify-run 的（即 agent 的）退出码。
# 测试用环境变量：ORCA_AGENT_LAUNCH_NOTIFY_RUN（notify-run 路径）、ORCA_AGENT_LAUNCH_WEBHOOK_DIR（webhook 目录）、
#   ORCA_AGENT_LAUNCH_DRY=1（只打印将要执行的命令，不写 Linear）、ORCA_AGENT_LAUNCH_ORCA（orca CLI 路径）。
set -u

# 测试时只认 ORCA_AGENT_LAUNCH_WEBHOOK_DIR，不退回 /home/box 下的真配置
webhook_env() {  # $1=bot → 能读的 env 文件路径
    if [ -n "${ORCA_AGENT_LAUNCH_WEBHOOK_DIR:-}" ]; then
        [ -r "$ORCA_AGENT_LAUNCH_WEBHOOK_DIR/$1.env" ] && echo "$ORCA_AGENT_LAUNCH_WEBHOOK_DIR/$1.env"
    elif [ -r "$HOME/.config/grokbot/webhooks/$1.env" ]; then
        echo "$HOME/.config/grokbot/webhooks/$1.env"
    elif [ -r "/home/box/.config/grokbot/webhooks/$1.env" ]; then
        echo "/home/box/.config/grokbot/webhooks/$1.env"
    fi
}
send_reject() (  # $1=bot $2=说明；子 shell 里读 env 文件，KEY 不留在主进程里。送达返回 0
    set +x
    env_file=$(webhook_env "$1") && [ -n "$env_file" ] || exit 1
    URL="" KEY=""
    . "$env_file"
    [ -n "$URL" ] && [ -n "$KEY" ] || exit 1
    body=$(python3 -c 'import json, socket, sys
a = sys.argv[1:]
print(json.dumps({"bot": a[0], "task": a[1], "issue": a[2], "machine": socket.gethostname(), "status": "stuck",
                  "kind": "agent_not_started", "source": "orca-agent-launch", "worktree": a[3], "orca_terminal": a[4],
                  "note": a[5]}, ensure_ascii=False))' "$1" "${task:-?}" "${issue:-}" "$PWD" "${ORCA_TERMINAL_HANDLE:-}" "$2") || exit 1
    http=$(printf 'Authorization: Bearer %s\n' "$KEY" | curl -sS -o /dev/null -w '%{http_code}' --max-time 20 -X POST -H @- \
        -H 'Content-Type: application/json' --data-binary "$body" "$URL" 2>/dev/null)
    /bin/echo "orca-agent-launch: 已把拒绝原因发给 $1（http=${http:-无响应}）" >&2 2>/dev/null || true
    case "$http" in 2??) exit 0 ;; esac
    exit 1
)
wake_reject() {  # $1=拒绝原因
    [ "${ORCA_AGENT_LAUNCH_DRY:-}" = 1 ] && return 0
    local to=coding-assistant note
    note="orca-agent-launch 拒绝：$1。agent 没起来（没有 notify-run，也不会有完工叫醒）；改好命令重新起"
    case "${bot:-}" in ""|*[!A-Za-z0-9._-]*|.*) ;; *) [ -n "$(webhook_env "$bot")" ] && to=$bot ;; esac
    send_reject "$to" "$note" && return 0
    [ "$to" = coding-assistant ] || send_reject coding-assistant "${note}（原本发给 ${to}，没发出去）" || true
}
die() { echo "orca-agent-launch: 拒绝：$*" >&2; wake_reject "$*"; exit 2; }
usage_text() { echo "用法: orca-agent-launch --bot <bot> --task \"<描述>\" [--issue X --eta <YYYY-MM-DD[ HH:MM]>] [--no-linear] -- <claude|pi|codex> [参数...]" >&2; }
usage() { usage_text; wake_reject "用法错误（参数不全）"; exit 2; }

bot="" task="" issue="" eta="" no_linear=""
while [ $# -gt 0 ]; do
    case "$1" in
        --bot)   [ $# -ge 2 ] || usage; bot=$2; shift 2 ;;
        --task)  [ $# -ge 2 ] || usage; task=$2; shift 2 ;;
        --issue) [ $# -ge 2 ] || usage; issue=$2; shift 2 ;;
        --eta)   [ $# -ge 2 ] || usage; eta=$2; shift 2 ;;
        --no-linear) no_linear=1; shift ;;
        --)      shift; break ;;
        -h|--help) usage_text; exit 2 ;;
        *)       break ;;
    esac
done
[ $# -gt 0 ] || usage
[ -n "$bot" ] || die "没带 --bot：agent 必须经 notify-run 起，做完才会叫醒派活的 bot"
[ -n "$task" ] || die "没带 --task"
case "$bot" in
    *[!A-Za-z0-9._-]*|.*) die "bot 名不合法：$bot" ;;
esac
wdir=${ORCA_AGENT_LAUNCH_WEBHOOK_DIR:-$HOME/.config/grokbot/webhooks}
[ -n "$(webhook_env "$bot")" ] || die "没有 $bot 的 webhook 配置（$wdir/$bot.env），叫醒发不出去"
agent=$(basename -- "$1")
case "$agent" in
    claude|pi|codex) ;;
    bash|sh|zsh|dash|env|nohup|setsid|exec|timeout|nice|sudo|script)
        die "不要经 $agent 转一层：agent 必须是 notify-run 的直接子进程（写成 -- claude ...）" ;;
    notify-run) die "已经由 orca-agent-launch 包 notify-run 了，直接写 -- claude ..." ;;
    *) die "只起 claude / pi / codex，不认识：$agent" ;;
esac
command -v -- "$1" >/dev/null 2>&1 || die "找不到命令：$1"
if [ -n "${ORCA_DISPATCH_PID:-}" ] && kill -0 "$ORCA_DISPATCH_PID" 2>/dev/null; then
    die "已经在 notify-run（pid ${ORCA_DISPATCH_PID}）里面，嵌套起的 agent 不算派出的主会话；请在新终端里起"
fi
due=""
if [ -n "$issue" ]; then
    case "$issue" in
        [A-Za-z]*-[0-9]*) ;;
        *) die "--issue 要写 Linear 编号（如 PER-66）：$issue" ;;
    esac
    [ -n "$eta" ] || [ -n "$no_linear" ] || die "带 --issue 要同时带 --eta（预计完成时间，写进 Linear 的 due），或者加 --no-linear"
    if [ -n "$eta" ]; then
        due=$(printf '%s' "$eta" | grep -Eo '^[0-9]{4}-[0-9]{2}-[0-9]{2}') || die "--eta 要以 YYYY-MM-DD 开头：$eta"
    fi
elif [ -n "$eta" ]; then
    die "--eta 只和 --issue 一起用"
fi
unset ORCA_DISPATCH_PID ORCA_DISPATCH_BOT ORCA_TASK_ID ORCA_DISPATCH_ISSUE ORCA_DISPATCH_TS
nr=${ORCA_AGENT_LAUNCH_NOTIFY_RUN:-$(command -v notify-run || echo "$HOME/.local/bin/notify-run")}
[ -x "$nr" ] || die "找不到 notify-run（${nr}）"
cmd=("$nr" --bot "$bot" --task "$task")
[ -n "$issue" ] && cmd+=(--issue "$issue")
# 决定 5A：仅本入口启动的 Claude 会话禁用 superpowers，不写用户设置。
# 合并已有 --settings（文件或 inline JSON），避免重复参数把调用方设置丢掉。
# 在构造命令时完成，dry-run 也展示同一份参数；pi/codex 原样转发。
if [ "$agent" = claude ]; then
    claude_bin=$1; shift
    claude_args=()
    session_settings='{}'
    seen_settings=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --) claude_args+=("$@"); break ;;
            --settings|--settings=*)
                [ "$seen_settings" = 0 ] || die "只接受一个 --settings，请先合并设置"
                seen_settings=1
                if [ "$1" = --settings ]; then
                    [ $# -ge 2 ] || die "--settings 缺少值"
                    session_settings=$2; shift 2
                else
                    session_settings=${1#--settings=}; shift
                fi ;;
            *) claude_args+=("$1"); shift ;;
        esac
    done
    # 固定 /tmp，不接受可能指向永久目录的 TMPDIR。macOS 的系统
    # com.apple.tmp_cleaner 每天清理 /tmp 的过期内容；不是进程退出即删。
    # mktemp 创建 0600 文件，不改变 notify-run -> claude 的直接父子关系。
    session_settings_file=$(mktemp /tmp/orca-claude-settings.XXXXXX) || die "建不了会话设置文件"
    trap 'rm -f -- "$session_settings_file"' EXIT
    python3 - "$session_settings" "$session_settings_file" <<'PY'
import json, pathlib, sys
try:
    raw = sys.argv[1]
    data = json.loads(raw) if raw.lstrip().startswith('{') else json.loads(pathlib.Path(raw).read_text())
    if not isinstance(data, dict):
        raise ValueError('settings must be an object')
    plugins = data.setdefault('enabledPlugins', {})
    if not isinstance(plugins, dict):
        raise ValueError('enabledPlugins must be an object')
    plugins['superpowers@claude-plugins-official'] = False
    # 文件输入也不展开到 argv/日志。mktemp 权限 0600；exec 后保留供会话读取。
    with open(sys.argv[2], 'w') as f:
        json.dump(data, f, ensure_ascii=False)
        f.write('\n')
except Exception:
    # 不打印调用方设置值：其中可能有凭据。
    sys.exit('无法读取或合并 --settings；没有启动 Claude')
PY
    [ $? -eq 0 ] || die "无法合并 Claude 会话设置"
    # 未启动（dry-run/Linear 拒绝/exec 失败）时清理。成功 exec 不跑 EXIT：
    # 由 macOS tmp_cleaner 延迟回收；会话结束后也可按打印路径提前删除。
    # 不按固定秒数提前删（无法确认 Claude 已读完且不会重读）。
    cmd+=(--tty -- "$claude_bin" --settings "$session_settings_file" ${claude_args[@]+"${claude_args[@]}"})
else
    cmd+=(--tty -- "$@")
fi
if [ "${ORCA_AGENT_LAUNCH_DRY:-}" = 1 ]; then
    [ -n "$issue" ] && [ -z "$no_linear" ] && echo "（会写 Linear ${issue}：due ${due}，负责 bot：${bot}）"
    printf '%q ' "${cmd[@]}"; echo
    exit 0
fi
if [ -n "$issue" ] && [ -z "$no_linear" ]; then
    orca=${ORCA_AGENT_LAUNCH_ORCA:-}
    [ -n "$orca" ] || orca=$(command -v orca-ide || command -v orca) || orca=""
    [ -n "$orca" ] || { [ -x "$HOME/.local/bin/orca" ] && orca=$HOME/.local/bin/orca; } ||
        orca=/Applications/Orca.app/Contents/Resources/bin/orca
    # 写 due，再补「负责 bot：」一行。失败就不起 agent：due 对账靠它。
    # Python 不放进 $(...) 里：/bin/bash 3.2 解析 $(...) 里的 here-doc 会出错（10-19 演练时整个脚本跑不起来）
    out=$(mktemp "${TMPDIR:-/tmp}/orca-agent-launch.XXXXXX") || die "建不了临时文件"
    python3 - "$orca" "$issue" "$due" "$bot" >"$out" <<'PY'
import json, re, subprocess, sys
orca, issue, due, bot = sys.argv[1:5]

def call(*args):
    p = subprocess.run([orca, "linear"] + list(args) + ["--json"], capture_output=True, text=True, timeout=60)
    try:
        d = json.loads(p.stdout)
    except ValueError:
        raise SystemExit("orca linear %s 没有返回 JSON：%s" % (args[0], (p.stderr or p.stdout).strip()[:200]))
    if not d.get("ok"):
        raise SystemExit("orca linear %s 失败：%s" % (args[0], json.dumps(d.get("error"), ensure_ascii=False)[:200]))
    return d.get("result") or {}

iss = call("issue", issue).get("issue") or {}
if not iss.get("identifier"):
    raise SystemExit("Linear 里找不到 %s" % issue)
call("due-date", "set", issue, "--to", due)
desc = iss.get("description") or ""
line = "负责 bot：%s" % bot
rx = re.compile(r"负责\s*bot\s*[:：]\s*([\w.\-]+)", re.I)
m = rx.search(desc)
if m and m.group(1) == bot:
    how = "描述里已有「%s」" % line
else:
    new = rx.sub(line, desc, count=1) if m else (desc.rstrip() + "\n\n" + line + "（orca-agent-launch 写入）").lstrip()
    call("save-issue", issue, "--description", new)
    how = "描述里%s「%s」" % ("把「负责 bot：%s」改成" % m.group(1) if m else "补了", line)
print("Linear %s：due 设为 %s；%s" % (iss["identifier"], due, how))
PY
    rc=$?
    msg=$(cat "$out"); rm -f "$out"
    if [ "$rc" -ne 0 ]; then
        echo "orca-agent-launch: 拒绝：Linear $issue 写不进去（见上）。确认要先起 agent 再补卡就加 --no-linear" >&2
        wake_reject "Linear $issue 写不进去（$(printf '%s' "$msg" | tail -1 | cut -c1-200)）"
        exit 3
    fi
    echo "orca-agent-launch: $msg" >&2
fi
[ "$agent" != claude ] || echo "orca-agent-launch: 本会话设置 ${session_settings_file}（0600；macOS 系统延迟清理，会话结束后可提前删除）" >&2
exec "${cmd[@]}"
