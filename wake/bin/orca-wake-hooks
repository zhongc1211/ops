#!/usr/bin/env python3
"""orca-wake-hooks: add or remove the orca-wake entries in a Claude Code settings.json.

  orca-wake-hooks install [--settings PATH] [--backup-dir DIR]
  orca-wake-hooks remove  [--settings PATH] [--backup-dir DIR]
  orca-wake-hooks check   [--settings PATH]

Only touches hook groups whose command mentions both "orca-wake" and "claude-hook"; every other entry
(for example Orca's own hooks) is left as it is. install and remove write a timestamped copy
of the file to --backup-dir (default: next to the settings file) before changing it.
"""
import argparse
import json
import os
import shutil
import sys
import time

COMMAND = '[ -z "${ORCA_DISPATCH_BOT:-}" ] || WAKE_AGENT_PID=$PPID "$HOME/.local/bin/orca-wake" claude-hook'


def hook(matcher=None):
    g = {"hooks": [{"type": "command", "command": COMMAND, "timeout": 10, "async": True}]}
    if matcher is not None:
        g = {"matcher": matcher, **g}
    return g


ENTRIES = {
    "UserPromptSubmit": hook(),
    "Stop": hook(),
    "StopFailure": hook(),
    "PermissionRequest": hook("*"),
    "Notification": hook("idle_prompt|permission_prompt|quota_auto_resume_disabled|quota_auto_resume_stale"),
}


def ours(group):
    cmds = [h.get("command") or "" for h in group.get("hooks") or [] if isinstance(h, dict)]
    return any("orca-wake" in c and "claude-hook" in c for c in cmds)


def load(path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)


def save(path, data, backup_dir):
    os.makedirs(backup_dir, exist_ok=True)
    bak = os.path.join(backup_dir, "%s.bak-%s" % (os.path.basename(path), time.strftime("%Y%m%d-%H%M%S")))
    shutil.copy2(path, bak)
    tmp = path + ".orca-wake.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, path)
    print("backup: " + bak)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("action", choices=["install", "remove", "check"])
    p.add_argument("--settings", default=os.path.expanduser("~/.claude/settings.json"))
    p.add_argument("--backup-dir")
    a = p.parse_args()
    data = load(a.settings)
    hooks = data.setdefault("hooks", {})
    present = {ev: sum(1 for g in hooks.get(ev) or [] if ours(g)) for ev in ENTRIES}
    if a.action == "check":
        for ev, n in present.items():
            print("%-18s %s" % (ev, "ok" if n == 1 else ("missing" if n == 0 else "duplicated x%d" % n)))
        return 0 if all(n == 1 for n in present.values()) else 1
    for ev, entry in ENTRIES.items():
        groups = [g for g in hooks.get(ev) or [] if not ours(g)]
        if a.action == "install":
            groups.append(entry)
        if groups:
            hooks[ev] = groups
        else:
            hooks.pop(ev, None)
    save(a.settings, data, a.backup_dir or os.path.dirname(os.path.abspath(a.settings)))
    print("%s: done (%s)" % (a.action, ", ".join(ENTRIES)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
