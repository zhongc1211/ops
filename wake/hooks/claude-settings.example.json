{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${ORCA_DISPATCH_BOT:-}\" ] || WAKE_AGENT_PID=$PPID \"$HOME/.local/bin/orca-wake\" claude-hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${ORCA_DISPATCH_BOT:-}\" ] || WAKE_AGENT_PID=$PPID \"$HOME/.local/bin/orca-wake\" claude-hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${ORCA_DISPATCH_BOT:-}\" ] || WAKE_AGENT_PID=$PPID \"$HOME/.local/bin/orca-wake\" claude-hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${ORCA_DISPATCH_BOT:-}\" ] || WAKE_AGENT_PID=$PPID \"$HOME/.local/bin/orca-wake\" claude-hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt|quota_auto_resume_disabled|quota_auto_resume_stale",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${ORCA_DISPATCH_BOT:-}\" ] || WAKE_AGENT_PID=$PPID \"$HOME/.local/bin/orca-wake\" claude-hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
