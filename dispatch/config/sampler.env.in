# ops-v5-sampler 配置（PER-126 v5 前提 2）。装到 ~/.config/dispatch/sampler.env。
# 只认 KEY=VALUE；脚本不 source 这个文件。版本不对或缺失时采样器报错退出（退出码 3）。
SAMPLER_CONFIG_VERSION=1

# 主机名：samples/<host>/ 的目录名。留空 = hostname -s 转小写（iMac -> imac，mba -> mba）。
SAMPLER_HOST=

# 上限（不删数据）：samples/<本机>/ 下的天数到 MAX_DAYS、或总大小到 MAX_TOTAL_MB 就停写，
# 记 ERROR 并在 ~/.local/state/ops-v5/ops-v5-sampler.status 写 state=full，install.sh --check 报警，由 ops 挪走旧文件。
# 实测每台每天约 6–7MB（22–23 个会话），9 天约 60MB，350MB 留足余量。
MAX_DAYS=9
MAX_TOTAL_MB=350

# 自身日志上限：超过 LOG_MAX_KB 就挪到 ~/.local/state/ops-v5/log-archive/<名字>.<时间>（不覆盖）。
# 归档到 LOG_ARCHIVE_MAX 份后不再写日志（状态文件照写）。launchd 的 stdout/stderr 日志同样处理。
LOG_MAX_KB=512
LOG_ARCHIVE_MAX=20

# 限时：每次 orca 调用、其他命令（ps/sysctl/df）、整轮。
ORCA_TIMEOUT_SEC=10
CMD_TIMEOUT_SEC=5
ROUND_TIMEOUT_SEC=30

# 进程名（comm 的 basename）在这个列表里就算 agent 进程；只计顶层的（祖先里没有 agent）。
AGENT_COMMS=claude,codex,pi,opencode,gemini,node
