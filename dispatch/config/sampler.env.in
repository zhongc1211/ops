# ops-v5-sampler 配置（PER-126 v5 前提 2）。装到 ~/.config/dispatch/sampler.env。
# 只认 KEY=VALUE；脚本不 source 这个文件。版本不对或缺失时采样器报错退出（退出码 3）。
SAMPLER_CONFIG_VERSION=1

# 主机名：samples/<host>/ 的目录名。留空 = hostname -s 转小写（iMac -> imac，mba -> mba）。
SAMPLER_HOST=

# 保留天数（含当天）和自己目录下 *.jsonl 的总大小上限，超了从最旧的删。
RETENTION_DAYS=14
MAX_TOTAL_MB=200

# 自身日志上限，超了轮转成 .log.1（最多两份）。launchd 的 stdout/stderr 日志同样处理。
LOG_MAX_KB=512

# 限时：每次 orca 调用、其他命令（ps/sysctl/df）、整轮。
ORCA_TIMEOUT_SEC=10
CMD_TIMEOUT_SEC=5
ROUND_TIMEOUT_SEC=30

# 进程名（comm 的 basename）在这个列表里就算 agent 进程；只计顶层的（祖先里没有 agent）。
AGENT_COMMS=claude,codex,pi,opencode,gemini,node
